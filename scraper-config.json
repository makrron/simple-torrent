{
  "tpb": {
    "name": "The Pirate Bay",
    "url": "https://tpb.party/search/{{query}}/{{page:1}}/7/0",
    "list": "#searchResult > tbody > tr",
    "result": {
      "name": "td:nth-child(2) a",
      "path": [
        "td:nth-child(2) a",
        "@href"
      ],
      "magnet": [
        "a[href^='magnet:']",
        "@href"
      ],
      "size": "td:nth-child(5)",
      "seeds": "td:nth-child(6)",
      "peers": "td:nth-child(7)"
    }
  },
  "yts": {
    "name": "YTS (YIFY)",
    "url": "https://en.yts-official.biz/browse-movies/{{query}}?page={{page:1}}",
    "list": "div.browse-movie-wrap",
    "result": {
      "name": "a.browse-movie-title",
      "url": [
        "a.browse-movie-title",
        "@href"
      ]
    }
  },
  "yts/item": {
    "name": "YTS (YIFY Item)",
    "url": "https://en.yts-official.biz{{item}}",
    "result": {
      "magnet": [
        "a[href^='magnet:']",
        "@href"
      ]
    }
  }
}