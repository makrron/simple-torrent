{
  "torrentgalaxy": {
    "name": "TorrentGalaxy",
    "url": "https://tgx.rs/torrents.php?search={{query}}&sort=id&order=desc&page={{page:0}}",
    "list": "div.tgxtablerow",
    "result": {
      "name": [
        "div:nth-of-type(4) div a",
        "@title"
      ],
      "url": [
        "div:nth-of-type(4) div a",
        "@href"
      ],
      "size": "div:nth-of-type(8)",
      "seeds": "div:nth-of-type(10)",
      "magnet": [
        "a[href^='magnet:']",
        "@href"
      ]
    }
  },
  "torrentgalaxy/item": {
    "name": "TorrentGalaxy/item",
    "url": "https://tgx.rs{{item}}",
    "result": {
      "infohash": [
        "div.torrentpagetable div.tprow:nth-of-type(7) div:nth-of-type(2)"
      ]
    }
  },
  "seedpeer": {
    "name": "SeedPeer",
    "url": "https://www.seedpeer.me/search/{{query}}?page={{page:1}}",
    "list": "div.table-container table.table tbody tr",
    "result": {
      "name": [
        "td:first-of-type",
        "@title"
      ],
      "url": [
        "td:first-of-type a",
        "@href"
      ],
      "size": "td:nth-of-type(3)",
      "seeds": "td:nth-of-type(4)",
      "peers": "td:nth-of-type(5)"
    }
  },
  "seedpeer/item": {
    "name": "SeedPeer/item",
    "url": "https://www.seedpeer.me{{item}}",
    "result": {
      "magnet": [
        "div.content div.is-one-third p:nth-of-type(3) a",
        "@href"
      ]
    }
  },
  "idope": {
    "name": "iDope",
    "url": "https://idope.se/torrent-list/{{query}}/?p={{page:1}}",
    "list": "div#div2child .resultdiv",
    "result": {
      "name": [
        ".resultdivtop a div.resultdivtopname",
        "s/[\\n\\t]+//g"
      ],
      "url": [
        "div.resultdivtop a",
        "@href"
      ],
      "size": ".resultlength .resultdivbottonlength",
      "seeds": ".resultseed .resultdivbottonseed"
    }
  },
  "idope/item": {
    "name": "iDope(Item)",
    "url": "https://idope.se/torrent/{{item}}",
    "result": {
      "magnet": "a#mangetinfo"
    }
  },
  "eztv": {
    "name": "EZTV",
    "url": "https://eztv.wf/search/{{query}}",
    "list": "tr.forum_header_border",
    "result": {
      "name": "td:nth-child(2) a.epinfo",
      "url": [
        "td:nth-child(2) a.epinfo",
        "@href"
      ],
      "magnet": [
        "td:nth-child(3) a.magnet",
        "@href"
      ],
      "size": "td:nth-child(4)",
      "seeds": "td:nth-child(6)"
    }
  },
  "1337x": {
    "name": "1337X",
    "url": "https://1337x.so/sort-search/{{query}}/seeders/desc/{{page:1}}/",
    "list": "table.table-list tbody tr, .box-info-detail table.table tr",
    "result": {
      "name": ".coll-1 a:nth-child(2)",
      "url": [
        ".coll-1 a:nth-child(2)",
        "@href"
      ],
      "seeds": ".coll-2",
      "peers": ".coll-3",
      "size": [
        ".coll-4",
        "/([\\d\\.]+ [KMGT]?B)/"
      ]
    }
  },
  "1337x/item": {
    "name": "1337X (Item)",
    "url": "https://1337x.so{{item}}",
    "result": {
      "magnet": [
        "a[href^='magnet:']",
        "@href"
      ]
    }
  },
  "abb": {
    "name": "The Audiobook Bay",
    "url": "https://audiobookbay.is/page/{{page:1}}?s={{query}}",
    "list": "#content > .post",
    "result": {
      "name": [
        "div.postTitle > h2 > a"
      ],
      "url": [
        "div.postTitle > h2 > a",
        "@href"
      ],
      "size": [
        "div.postContent",
        "/File Size: ([\\d\\.]+ [KMGT]?B)/"
      ]
    }
  },
  "abb/item": {
    "name": "The Audiobook Bay (Item)",
    "url": "https://audiobookbay.is{{item}}",
    "result": {
      "infohash": "/td>([a-f0-9]+)</",
      "tracker": "table.torrent_info tr:nth-child(1) td:nth-child(2)"
    }
  },
  "lt": {
    "name": "LimeTorrents",
    "url": "https://www.limetorrents.lol/search/all/{{query}}/seeds/{{page:1}}/",
    "list": ".table2 tbody tr:nth-child(n+2)",
    "result": {
      "name": [
        ".tt-name a:nth-child(2)"
      ],
      "url": [
        ".tt-name a:nth-child(2)",
        "@href"
      ],
      "size": "td:nth-child(3)",
      "seeds": "td:nth-child(4)",
      "peers": "td:nth-child(5)"
    }
  },
  "lt/item": {
    "name": "LimeTorrents (Item)",
    "url": "https://www.limetorrents.lol{{item}}",
    "result": {
      "magnet": [
        "a.csprite_dltorrent[href^=\"magnet:\"]",
        "@href"
      ]
    }
  },
  "tpb": {
    "name": "The Pirate Bay",
    "url": "https://tpb.party/search/{{query}}/{{page:1}}/7/0",
    "list": "#searchResult > tbody > tr",
    "result": {
      "name": "a.detLink",
      "path": [
        "a.detLink",
        "@href"
      ],
      "magnet": [
        "a[href^='magnet:']",
        "@href"
      ],
      "size": [
        "font.detDesc",
        "/Size ([^,]+)/"
      ],
      "seeds": "td:nth-child(3)",
      "peers": "td:nth-child(4)"
    }
  },
  "nyaa": {
    "name": "Nyaa",
    "url": "https://nyaa.si/?f=0&c=0_0&s=seeders&o=desc&q={{query}}&p={{page:1}}",
    "list": "table.torrent-list > tbody > tr",
    "result": {
      "name": [
        "td:nth-child(2) a:not(.comments)"
      ],
      "path": [
        "td:nth-child(2) a:not(.comments)",
        "@href"
      ],
      "magnet": [
        "a[href^='magnet:']",
        "@href"
      ],
      "size": "td:nth-child(4)",
      "seeds": "td:nth-child(6)",
      "peers": "td:nth-child(7)"
    }
  }
}